{
  "name": "cipherbid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "chain": "anvil --host 127.0.0.1 --port 8546 --chain-id 31338 --silent",
    "contracts:build": "forge build && tsx scripts/artifacts.ts",
    "deploy:local": "pnpm contracts:build && tsx scripts/local.ts deploy",
    "seed": "tsx scripts/local.ts seed",
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "demo": "tsx scripts/local.ts demo",
    "time:advance": "tsx scripts/local.ts time",
    "test": "pnpm test:contracts && pnpm test:unit",
    "test:contracts": "forge test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "licenses": "pnpm licenses list --prod"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.104.2",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.7",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/cast": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
